{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kota",
  "version": "0.7.0",
  "identifier": "io.github.ensignalp.Kota",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popup",
        "title": "Kota",
        "url": "index.html",
        "width": 460,
        "height": 720,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true,
        "focus": true,
        "windowEffects": { "effects": ["acrylic"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Muhammed Alparslan",
    "homepage": "https://github.com/ensignalp/kota",
    "copyright": "MIT",
    "shortDescription": "AI usage limits in the taskbar",
    "longDescription": "Kota shows how much of your AI subscription limits you have used: Claude, Codex, Gemini, GitHub Copilot and API balances.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
